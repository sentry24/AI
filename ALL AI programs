% ============================================================
%  PROLOG PROGRAMS - All 15 Questions
% ============================================================


% ============================================================
% 1. FAMILY TREE - Family Relationships
% ============================================================

% Facts: parent(Parent, Child)
parent(tom, bob).
parent(tom, liz).
parent(bob, ann).
parent(bob, pat).
parent(pat, jim).

% Derived Relationships
grandparent(X, Z) :- parent(X, Y), parent(Y, Z).
sibling(X, Y)     :- parent(Z, X), parent(Z, Y), X \= Y.
ancestor(X, Y)    :- parent(X, Y).
ancestor(X, Y)    :- parent(X, Z), ancestor(Z, Y).

% Usage:
% ?- parent(tom, bob).         => true
% ?- grandparent(tom, ann).    => true
% ?- sibling(bob, liz).        => true
% ?- ancestor(tom, jim).       => true


% ============================================================
% 2. CONC(L1, L2, L3) - Append L2 to L1 to get L3
% ============================================================

conc([], L, L).
conc([H|T], L2, [H|L3]) :- conc(T, L2, L3).

% Usage:
% ?- conc([1,2], [3,4], L3).   => L3 = [1,2,3,4]


% ============================================================
% 3. REVERSE(L, R) - Reverse a list
% ============================================================

reverse_list([], []).
reverse_list([H|T], R) :-
    reverse_list(T, RT),
    conc(RT, [H], R).

% Usage:
% ?- reverse_list([1,2,3], R).  => R = [3,2,1]


% ============================================================
% 4. SUM OF TWO NUMBERS
% ============================================================

sum(X, Y, S) :- S is X + Y.

% Usage:
% ?- sum(3, 4, S).   => S = 7


% ============================================================
% 5. MAX(X, Y, M) - Maximum of two numbers
% ============================================================

max(X, Y, X) :- X >= Y.
max(X, Y, Y) :- Y > X.

% Usage:
% ?- max(3, 7, M).   => M = 7


% ============================================================
% 6. FACTORIAL(N, F) - Factorial of N
% ============================================================

factorial(0, 1) :- !.
factorial(N, F) :-
    N > 0,
    N1 is N - 1,
    factorial(N1, F1),
    F is N * F1.

% Usage:
% ?- factorial(5, F).   => F = 120


% ============================================================
% 7. GENERATE_FIB(N, T) - Nth term of Fibonacci series
% ============================================================

generate_fib(0, 0) :- !.
generate_fib(1, 1) :- !.
generate_fib(N, T) :-
    N > 1,
    N1 is N - 1,
    N2 is N - 2,
    generate_fib(N1, T1),
    generate_fib(N2, T2),
    T is T1 + T2.

% Usage:
% ?- generate_fib(7, T).   => T = 13


% ============================================================
% 8. POWER(Num, Pow, Ans) - Num raised to the power Pow
% ============================================================

power(_, 0, 1) :- !.
power(Num, Pow, Ans) :-
    Pow > 0,
    Pow1 is Pow - 1,
    power(Num, Pow1, Ans1),
    Ans is Num * Ans1.

% Usage:
% ?- power(2, 10, Ans).   => Ans = 1024


% ============================================================
% 9. MULTI(N1, N2, R) - Multiply two numbers
% ============================================================

multi(N1, N2, R) :- R is N1 * N2.

% Usage:
% ?- multi(6, 7, R).   => R = 42


% ============================================================
% 10. MEMB(X, L) - Check if X is a member of L
% ============================================================

memb(X, [X|_]).
memb(X, [_|T]) :- memb(X, T).

% Usage:
% ?- memb(3, [1,2,3,4]).   => true
% ?- memb(5, [1,2,3,4]).   => false


% ============================================================
% 11. SUMLIST(L, S) - Sum of all elements in list L
% ============================================================

sumlist([], 0).
sumlist([H|T], S) :-
    sumlist(T, S1),
    S is S1 + H.

% Usage:
% ?- sumlist([1,2,3,4,5], S).   => S = 15


% ============================================================
% 12. EVENLENGTH / ODDLENGTH - Check even or odd list length
% ============================================================

evenlength([]).
evenlength([_,_|T]) :- evenlength(T).

oddlength([_]).
oddlength([_,_|T]) :- oddlength(T).

% Usage:
% ?- evenlength([1,2,3,4]).   => true
% ?- oddlength([1,2,3]).      => true


% ============================================================
% 13. MAXLIST(L, M) - Maximum element in a list
% ============================================================

maxlist([X], X).
maxlist([H|T], M) :-
    maxlist(T, M1),
    (H > M1 -> M = H ; M = M1).

% Usage:
% ?- maxlist([3,1,4,1,5,9,2,6], M).   => M = 9


% ============================================================
% 14. INSERT(I, N, L, R) - Insert item I at Nth position of L
% ============================================================

insert(I, 1, L, [I|L]).
insert(I, N, [H|T], [H|R]) :-
    N > 1,
    N1 is N - 1,
    insert(I, N1, T, R).

% Usage:
% ?- insert(99, 3, [1,2,3,4,5], R).
%    => R = [1,2,99,3,4,5]


% ============================================================
% 15. DELETE(N, L, R) - Remove element at Nth position from L
% ============================================================

delete_nth(1, [_|T], T).
delete_nth(N, [H|T], [H|R]) :-
    N > 1,
    N1 is N - 1,
    delete_nth(N1, T, R).

% Usage:
% ?- delete_nth(3, [1,2,3,4,5], R).
%    => R = [1,2,4,5]
